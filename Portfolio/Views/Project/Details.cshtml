@model Portfolio.Models.ProjectDetailsViewModel

@{
    ViewData["Title"] = Model.Project.Title;
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Portfolio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Project.Title</li>
                </ol>
            </nav>

            <div class="card border-0 shadow-lg overflow-hidden mb-5">
                <img src="@Model.Project.ThumbnailUrl" class="img-fluid w-100" alt="@Model.Project.Title" style="max-height: 450px; object-fit: cover;" />
                <div class="card-body p-5">
                    <h1 class="fw-bolder mb-3">@Model.Project.Title</h1>
                    <p class="lead text-secondary mb-4" style="line-height: 1.8;">@Model.Project.FullDescription</p>

                    <a href="@Model.Project.GitHubLink" target="_blank" class="btn btn-dark px-4 py-2 rounded-pill shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-github me-2" viewBox="0 0 16 16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
                        View Repository
                    </a>
                </div>
            </div>

            <hr class="mb-5" />

            <div class="row">
                <div class="col-md-8 mx-auto">
                    <h3 class="fw-bold mb-4">Feedback & Comments</h3>

                    @if (Model.Comments.Any())
                    {
                        <div class="d-flex flex-column gap-3 mb-5">
                            @foreach (var comment in Model.Comments)
                            {
                                <div>
                                    <span class="fw-bold fs-6 ms-2">@comment.AuthorName</span>
                                    <span class="text-muted ms-2" style="font-size: 0.85rem;">@comment.Timestamp.ToString("MMM dd, yyyy h:mm tt")</span>
                                    <div class="comment-bubble mt-1 shadow-sm">
                                        <p class="mb-0 text-dark">@comment.CommentText</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border-0 shadow-sm text-center py-4 mb-5">
                            <p class="text-muted mb-0">No comments yet. Log in to be the first to share your thoughts!</p>
                        </div>
                    }

                    @if (ViewBag.IsLoggedIn == true)
                    {
                        <div class="card shadow-sm border-0 rounded-3 bg-light">
                            <div class="card-body p-4">
                                <h5 class="card-title fw-bold mb-3">Leave a Reply</h5>
                                <form asp-controller="Project" asp-action="AddComment" method="post">
                                    <input type="hidden" asp-for="NewComment.ProjectId" />
                                    <div class="form-group mb-3">
                                        <textarea asp-for="NewComment.CommentText" class="form-control border-0 shadow-sm" rows="4" placeholder="Write your feedback here..." required></textarea>
                                    </div>
                                    <div class="text-end">
                                        <button type="submit" class="btn btn-primary px-4 rounded-pill fw-semibold shadow-sm">Post Comment</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning border-0 shadow-sm d-flex justify-content-between align-items-center p-4 rounded-3">
                            <div>
                                <h6 class="fw-bold mb-1"><i class="bi bi-lock-fill"></i> Authentication Required</h6>
                                <p class="mb-0 text-muted small">You must be signed in with administrator credentials to leave a comment.</p>
                            </div>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-warning fw-semibold rounded-pill px-4">Log In</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>