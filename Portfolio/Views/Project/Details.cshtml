@model Portfolio.Models.ProjectDetailsViewModel

@{
    ViewData["Title"] = Model.Project.Title;
}

<div class="container mt-4">
    <!-- Project Details -->
    <div class="row mb-5">
        <div class="col-md-8">
            <img src="@Model.Project.ThumbnailUrl" class="img-fluid rounded mb-3 shadow" alt="@Model.Project.Title" style="width: 100%; max-height: 400px; object-fit: cover; background-color: #e9ecef;" />
            <h1>@Model.Project.Title</h1>
            <p class="lead">@Model.Project.FullDescription</p>
            <a href="@Model.Project.GitHubLink" target="_blank" class="btn btn-dark mt-2">View Code on GitHub</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-2 ms-2">Back to Portfolio</a>
        </div>
    </div>

    <hr />

    <!-- Comment Section -->
    <div class="row">
        <div class="col-md-8">
            <h3>Comments</h3>

            @if (Model.Comments.Any())
            {
                <div class="list-group mb-4">
                    @foreach (var comment in Model.Comments)
                    {
                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1 fw-bold">@comment.AuthorName</h6>
                                <small class="text-muted">@comment.Timestamp.ToString("MMM dd, yyyy HH:mm")</small>
                            </div>
                            <p class="mb-1">@comment.CommentText</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-4">No comments yet. Log in to be the first!</p>
            }

            <!-- Restricted Comment Form -->
            @if (ViewBag.IsLoggedIn == true)
            {
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Add a Comment</h5>
                        <form asp-controller="Project" asp-action="AddComment" method="post">
                            <input type="hidden" asp-for="NewComment.ProjectId" />
                            <div class="form-group mb-3">
                                <textarea asp-for="NewComment.CommentText" class="form-control" rows="3" placeholder="Write your feedback here..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary">Post Comment</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    You must <a asp-controller="Account" asp-action="Login">log in</a> to leave a comment.
                </div>
            }
        </div>
    </div>
</div>